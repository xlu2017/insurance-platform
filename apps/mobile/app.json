{
  "expo": {
    "name": "Insurance Autopilot",
    "slug": "insurance-autopilot",
    "version": "0.1.0",
    "scheme": "insurance-autopilot",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.insuranceautopilot.app"
    },
    "android": {
      "package": "com.insuranceautopilot.app",
      "versionCode": 1,
      "permissions": ["INTERNET"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ]
  }
}

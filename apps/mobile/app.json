{
  "expo": {
    "name": "Insurance Autopilot",
    "slug": "insurance-autopilot",
    "version": "0.1.0",
    "scheme": "insurance-autopilot",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.insuranceautopilot.app"
    },
    "android": {
      "package": "com.insuranceautopilot.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Insurance Autopilot to select photos of insurance documents.",
          "cameraPermission": "Allow Insurance Autopilot to photograph insurance documents.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ]
  }
}

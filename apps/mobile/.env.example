# Local Supabase (supabase start prints these values).
# Use your machine's LAN IP instead of 127.0.0.1 when testing on a device.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Document-processing consent configuration.
EXPO_PUBLIC_PRIVACY_NOTICE_URL=https://example.com/privacy
EXPO_PUBLIC_PROCESSOR_CONTRACT_VERSION=replace-with-processor-contract-version

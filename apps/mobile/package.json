{
  "name": "@autopilot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:apk:local": "expo run:android --variant release",
    "lint": "eslint app lib components",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "expo:doctor": "expo config --type public"
  },
  "dependencies": {
    "@autopilot/database": "workspace:*",
    "@autopilot/design-tokens": "workspace:*",
    "@autopilot/schemas": "workspace:*",
    "@hookform/resolvers": "3.9.1",
    "@supabase/supabase-js": "2.47.10",
    "@tanstack/react-query": "5.62.11",
    "expo": "~52.0.23",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.1",
    "expo-image-picker": "~16.0.3",
    "expo-linking": "~7.0.3",
    "expo-local-authentication": "~15.0.1",
    "expo-notifications": "~0.29.11",
    "expo-router": "~4.0.15",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "^57.0.1",
    "phosphor-react-native": "3.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.2",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "~0.19.13",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@autopilot/config": "workspace:*",
    "@babel/core": "7.26.0",
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "29.5.14",
    "@types/react": "~18.3.12",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "jest-expo": "~52.0.2",
    "react-test-renderer": "18.3.1",
    "typescript": "5.7.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((\\.pnpm|\\.deno)/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-svg|@autopilot)(/|@|-|$))"
    ]
  }
}

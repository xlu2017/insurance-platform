# Copy to .env.local for local development; never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
PAYMENTS_BYPASS=true

# Google OAuth/OIDC for Supabase Auth ([auth.external.google] in supabase/config.toml).
# Export these in the shell that runs `supabase start`; never commit real values.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-oauth-client-secret
# If Supabase is reached over a public tunnel (e.g. *.loca.lt) instead of
# localhost, Google must redirect to that public URL. Set the committed default
# in config.toml ([auth.external.google].redirect_uri) to your tunnel callback
# locally, e.g. https://<subdomain>.loca.lt/auth/v1/callback, and register the
# SAME URL as an Authorized redirect URI on the Google OAuth client. The tunnel
# host is ephemeral, so do not commit it.

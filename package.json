{
  "name": "insurance-autopilot",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.18.0 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:schemas": "pnpm --filter @autopilot/schemas test",
    "test:engine": "pnpm --filter @autopilot/insurance-engine test",
    "test:db": "supabase test db",
    "test:database": "bash scripts/ci/run-database.sh",
    "test:e2e": "bash scripts/ci/run-e2e.sh",
    "test:private-policy-import": "tsx packages/document-extraction/scripts/private-policy-import.ts",
    "typecheck:edge": "bash scripts/ci/typecheck-edge.sh",
    "ci:static": "bash scripts/ci/run-static.sh",
    "ci:database": "bash scripts/ci/run-database.sh",
    "ci:e2e": "bash scripts/ci/run-e2e.sh",
    "ci:local": "bash scripts/ci/run-all.sh",
    "db:types": "supabase gen types typescript --local --schema public > packages/database/src/database.types.ts && pnpm prettier --config .prettierrc --write packages/database/src/database.types.ts",
    "db:types:check": "supabase gen types typescript --local --schema public > /tmp/database.types.ts && pnpm prettier --config .prettierrc --write /tmp/database.types.ts && diff -u packages/database/src/database.types.ts /tmp/database.types.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "18.3.12"
    }
  },
  "devDependencies": {
    "pdfjs-dist": "^6.1.200",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

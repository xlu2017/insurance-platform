{
  "name": "@autopilot/document-extraction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/*.integration.test.ts",
    "build:edge": "tsx scripts/build-edge-bundle.ts",
    "check:edge": "pnpm build:edge && git diff --exit-code ../../supabase/functions/_shared/document-extraction.js"
  },
  "dependencies": {
    "@autopilot/schemas": "workspace:*",
    "@napi-rs/canvas": "1.0.2",
    "path2d": "0.3.3",
    "pdfjs-dist": "^6.1.200",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@autopilot/config": "workspace:*",
    "@autopilot/test-fixtures": "workspace:*",
    "@supabase/supabase-js": "2.47.10",
    "canvas": "^3.2.3",
    "esbuild": "^0.28.1",
    "eslint": "9.17.0",
    "tsx": "^4.23.1",
    "typescript": "5.7.2",
    "undici": "^6.27.0",
    "vitest": "2.1.8"
  }
}
